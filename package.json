{
  "name": "@forlagshuset/nestjs-mongoose-paginate",
  "version": "2.2.3",
  "description": "A pagination, filtering and sorting lib for nestjs using mongoose orm",
  "main": "dist/index.js",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc --ignore '**/*.spec.ts' --ignore '**/*.test.ts' --ignore '**/test/**'",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:full": "npm run build && npm run build:types",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "prepare": "npm run build:full",
    "prepublishOnly": "npm test && npm run lint",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fagbokforlaget/nestjs-mongoose-paginate.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fagbokforlaget/nestjs-mongoose-paginate/issues"
  },
  "homepage": "https://github.com/fagbokforlaget/nestjs-mongoose-paginate#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "ajv": "^8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "rxjs": "^7.8.2"
  }
}
