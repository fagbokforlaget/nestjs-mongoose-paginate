{
  "name": "@forlagshuset/nestjs-mongoose-paginate",
  "version": "2.2.5",
  "description": "A pagination, filtering and sorting lib for nestjs using mongoose orm",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:full": "npm run build && npm run build:types",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run test:e2e && npm run lint",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fagbokforlaget/nestjs-mongoose-paginate.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fagbokforlaget/nestjs-mongoose-paginate/issues"
  },
  "homepage": "https://github.com/fagbokforlaget/nestjs-mongoose-paginate#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.3.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "ajv": "^8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "rxjs": "^7.8.2"
  }
}
